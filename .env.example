# Copie para .env (nunca faça commit do .env) e preencha.
# Na Vercel, cadastre as mesmas variáveis em Settings → Environment Variables.

# Connection string do Neon (Postgres)
DATABASE_URL=

# String aleatória para assinar o cookie do admin. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
